# Naive single-stage image on node:22-slim — middle point for the size comparison in README
# (between node:22 naive and the real multi-stage node:22-slim runner).
# Not used by the stack (docker-compose.yml builds ../Dockerfile).
FROM node:22-slim
WORKDIR /app
COPY . .
RUN npm install
RUN npm run build
EXPOSE 3000
CMD ["node", "dist/server.js"]
